{
  "name": "Invoice & Bukti Transfer AI to Sheets & Drive",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "11111111-1111-1111-1111-111111111111",
      "name": "1. Terima File Telegram",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "get",
        "fileId": "={{ $json.message.photo ? $json.message.photo[$json.message.photo.length - 1].file_id : ($json.message.document ? $json.message.document.file_id : '') }}",
        "additionalFields": {},
        "download": true
      },
      "id": "22222222-2222-2222-2222-222222222222",
      "name": "1.5 Unduh File dari Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=AQ.Ab8RN6K1FbOKhiBfJp_Z9iTOb3VCco7xAqkwQ42At7fzZgbIZg",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"inline_data\": {\n            \"mime_type\": \"{{ $binary.data.mimeType || 'image/jpeg' }}\",\n            \"data\": \"{{ $binary.data.data }}\"\n          }\n        },\n        {\n          \"text\": \"Anda adalah AI akuntansi ahli ekstraksi dokumen PEMASUKAN (Sales Invoice, Bukti Transfer, Nota Penjualan). Ekstrak data: No. Invoice, Tanggal (YYYY-MM-DD), Nama Klien (jika inisial: FA -> Fariz Abidin, MBP -> PT Maju Bersama Perkasa), Deskripsi, Kategori, Subtotal, Pajak, Diskon, Total Nominal (angka murni), Bank Tujuan, Status (Lunas/DP). Output WAJIB HANYA JSON murni tanpa markdown: {\\\"invoice_number\\\":\\\"...\\\",\\\"invoice_date\\\":\\\"...\\\",\\\"customer_name\\\":\\\"...\\\",\\\"description\\\":\\\"...\\\",\\\"category\\\":\\\"...\\\",\\\"subtotal\\\":0,\\\"tax\\\":0,\\\"discount\\\":0,\\\"total_amount\\\":0,\\\"payment_method\\\":\\\"...\\\",\\\"status\\\":\\\"Lunas\\\"}\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"response_mime_type\": \"application/json\"\n  }\n}",
        "options": {}
      },
      "id": "33333333-3333-3333-3333-333333333333",
      "name": "2. Gemini AI Vision",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const text = $json.candidates[0].content.parts[0].text;\nlet parsed = {};\ntry {\n  parsed = JSON.parse(text);\n} catch(e) {\n  parsed = { error: 'Gagal parse JSON Gemini', raw: text };\n}\n\n// Teruskan binary file dari node unduh file agar bisa diupload ke Google Drive\nconst binaryData = $('1.5 Unduh File dari Telegram').first().binary;\n\nreturn [{\n  json: parsed,\n  binary: binaryData\n}];"
      },
      "id": "44444444-4444-4444-4444-444444444444",
      "name": "3. Parse Hasil AI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://script.google.com/macros/s/AKfycbxlfQr-C8ivr6CL7SdBIEX5TRxG_OD4eR9SyrYw6fduPZZjIPPParTPDynUnJ-fZumW7w/exec",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"invoice_number\": \"{{ $json.invoice_number || '-' }}\",\n  \"invoice_date\": \"{{ $json.invoice_date || '-' }}\",\n  \"customer_name\": \"{{ $json.customer_name || 'Pelanggan Umum' }}\",\n  \"description\": \"{{ $json.description || 'Pemasukan' }}\",\n  \"category\": \"{{ $json.category || 'Pemasukan' }}\",\n  \"subtotal\": {{ $json.subtotal || 0 }},\n  \"tax\": {{ $json.tax || 0 }},\n  \"discount\": {{ $json.discount || 0 }},\n  \"total_amount\": {{ $json.total_amount || 0 }},\n  \"payment_method\": \"{{ $json.payment_method || '-' }}\",\n  \"status\": \"{{ $json.status || 'Lunas' }}\",\n  \"notes\": \"Dicatat via n8n Automation\",\n  \"file_base64\": \"{{ $binary.data ? $binary.data.data : '' }}\",\n  \"file_name\": \"Bukti_{{ $json.invoice_number || 'transfer' }}.jpg\",\n  \"file_mime\": \"{{ $binary.data ? $binary.data.mimeType : 'image/jpeg' }}\"\n}",
        "options": {}
      },
      "id": "55555555-5555-5555-5555-555555555555",
      "name": "4. Simpan ke Sheets & Drive",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1080,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('1. Terima File Telegram').first().json.message.chat.id }}",
        "text": "=✅ *TRANSAKSI BERHASIL DICATAT!*\n━━━━━━━━━━━━━━━━━━━━\n👤 *Klien:* {{ $('3. Parse Hasil AI').first().json.customer_name }}\n🧾 *No. Ref/Inv:* `{{ $('3. Parse Hasil AI').first().json.invoice_number }}`\n💰 *Total:* Rp {{ Number($('3. Parse Hasil AI').first().json.total_amount || 0).toLocaleString('id-ID') }}\n🏦 *Bank/Metode:* {{ $('3. Parse Hasil AI').first().json.payment_method }}\n📌 *Status:* {{ $('3. Parse Hasil AI').first().json.status }}\n\n📂 *Bukti Google Drive:* {{ $json.drive_url }}\n📊 *Status Sheets:* {{ $json.message }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "66666666-6666-6666-6666-666666666666",
      "name": "5. Balas Pesan ke Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1300,
        300
      ]
    }
  ],
