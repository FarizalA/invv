{
  "name": "Invoice Income to Drive & Sheets + AI Agent",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ]
      },
      "id": "10000000-0000-0000-0000-000000000001",
      "name": "1. Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        160,
        380
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.message.photo || $json.message.document ? 'file' : 'text' }}",
              "rightValue": "file",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "10000000-0000-0000-0000-000000000002",
      "name": "2. Filter: File atau Pertanyaan Teks?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        380,
        380
      ]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "get",
        "fileId": "={{ $json.message.photo ? $json.message.photo[$json.message.photo.length - 1].file_id : $json.message.document.file_id }}",
        "download": true
      },
      "id": "10000000-0000-0000-0000-000000000003",
      "name": "3A. Unduh File Gambar/PDF",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        600,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "// Ambil binary dari n8n Cloud filesystem secara aman\nconst binaryBuffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst base64Data = binaryBuffer.toString('base64');\nconst mimeType = $binary.data ? $binary.data.mimeType : 'image/jpeg';\n\nreturn [{\n  json: {\n    image_base64: base64Data,\n    image_mime: mimeType,\n    chat_id: $('1. Telegram Trigger').first().json.message.chat.id\n  }\n}];"
      },
      "id": "10000000-0000-0000-0000-000000000035",
      "name": "3B. Siapkan Gambar Base64",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite-preview:generateContent?key=AQ.Ab8RN6K1FbOKhiBfJp_Z9iTOb3VCco7xAqkwQ42At7fzZgbIZg",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"inlineData\": {\n            \"mimeType\": \"{{ $json.image_mime }}\",\n            \"data\": \"{{ $json.image_base64 }}\"\n          }\n        },\n        {\n          \"text\": \"Anda adalah AI akuntansi ahli ekstraksi dokumen PEMASUKAN (Sales Invoice, Bukti Transfer, Nota Penjualan). Ekstrak data: No. Invoice, Tanggal (YYYY-MM-DD), Nama Klien (jika inisial: FA -> Fariz Abidin, MBP -> PT Maju Bersama Perkasa), Deskripsi, Kategori, Subtotal, Pajak, Diskon, Total Nominal (angka murni), Bank Tujuan, Status (Lunas/DP). Output WAJIB HANYA JSON murni tanpa markdown: {\\\"invoice_number\\\":\\\"...\\\",\\\"invoice_date\\\":\\\"...\\\",\\\"customer_name\\\":\\\"...\\\",\\\"description\\\":\\\"...\\\",\\\"category\\\":\\\"...\\\",\\\"subtotal\\\":0,\\\"tax\\\":0,\\\"discount\\\":0,\\\"total_amount\\\":0,\\\"payment_method\\\":\\\"...\\\",\\\"status\\\":\\\"Lunas\\\"}\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"response_mime_type\": \"application/json\"\n  }\n}"
      },
      "id": "10000000-0000-0000-0000-000000000004",
      "name": "4A. Gemini Ekstraksi Bukti",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1020,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "const text = $json.candidates[0].content.parts[0].text;\nlet parsed = {};\ntry {\n  const cleanJson = text.replace(/```json/g, '').replace(/```/g, '').trim();\n  parsed = JSON.parse(cleanJson);\n} catch(e) {\n  parsed = { error: 'Gagal parse JSON Gemini', raw: text };\n}\n\n// Bawa base64 gambar dari node 3B untuk dikirim ke Google Drive\ntry {\n  const imgNode = $('3B. Siapkan Gambar Base64').first();\n  if (imgNode && imgNode.json && imgNode.json.image_base64) {\n    parsed.file_base64 = imgNode.json.image_base64;\n    parsed.file_mime = imgNode.json.image_mime || 'image/jpeg';\n  }\n} catch(err) {\n  parsed.binary_err = err.toString();\n}\n\nreturn [{ json: parsed }];"
      },
      "id": "10000000-0000-0000-0000-000000000005",
      "name": "5A. Parse JSON Hasil AI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://script.google.com/macros/s/AKfycbxtbP26drGs9uMBDcB8RH9Jb1DrScw72bQPD28ySi6k1dvQRExAcUFhPyFOzB0z4bLJgQ/exec",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"invoice_number\": \"{{ $json.invoice_number || '-' }}\",\n  \"invoice_date\": \"{{ $json.invoice_date || '-' }}\",\n  \"customer_name\": \"{{ $json.customer_name || 'Pelanggan Umum' }}\",\n  \"description\": \"{{ $json.description || '-' }}\",\n  \"category\": \"{{ $json.category || 'Pemasukan' }}\",\n  \"subtotal\": {{ $json.subtotal || 0 }},\n  \"tax\": {{ $json.tax || 0 }},\n  \"discount\": {{ $json.discount || 0 }},\n  \"total_amount\": {{ $json.total_amount || 0 }},\n  \"payment_method\": \"{{ $json.payment_method || '-' }}\",\n  \"status\": \"{{ $json.status || 'Lunas' }}\",\n  \"notes\": \"Dicatat otomatis via Telegram Bot\",\n  \"file_base64\": \"{{ $json.file_base64 || '' }}\",\n  \"file_name\": \"Bukti_{{ $json.invoice_number || 'transfer' }}.jpg\",\n  \"file_mime\": \"{{ $json.file_mime || 'image/jpeg' }}\"\n}"
      },
      "id": "10000000-0000-0000-0000-000000000006",
      "name": "6A. Simpan ke Google Sheets & Drive",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1460,
        220
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('1. Telegram Trigger').first().json.message.chat.id }}",
        "text": "=✅ *PEMASUKAN BARU BERHASIL DICATAT!*\n━━━━━━━━━━━━━━━━━━━━\n👤 *Klien:* {{ $('5A. Parse JSON Hasil AI').first().json.customer_name }}\n🧾 *No. Ref/Inv:* `{{ $('5A. Parse JSON Hasil AI').first().json.invoice_number }}`\n💰 *Total:* Rp {{ Number($('5A. Parse JSON Hasil AI').first().json.total_amount || 0).toLocaleString('id-ID') }}\n🏦 *Bank / Metode:* {{ $('5A. Parse JSON Hasil AI').first().json.payment_method }}\n📌 *Status:* {{ $('5A. Parse JSON Hasil AI').first().json.status }}\n\n📂 *Bukti Drive:* {{ $json.drive_url }}\n\n💡 _Ketik pertanyaan seperti \"Berapa total pemasukan bulan ini?\" untuk ngobrol dengan AI Agen._",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "10000000-0000-0000-0000-000000000007",
      "name": "7A. Notifikasi Teks ke Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1680,
        220
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message.text }}",
        "options": {
          "systemMessage": "=Anda adalah AI Agen Keuangan & Pembukuan pribadi yang ramah, cerdas, dan teliti.\nTugas utama Anda adalah:\n1. Membantu pengguna melihat, mengecek, menghitung, dan menganalisis data keuangan pemasukan yang ada di Google Sheets.\n2. SELALU gunakan Tool 'Ambil_Data_Google_Sheets' untuk mendapatkan data transaksi riil terkini saat pengguna bertanya tentang pemasukan, klien, saldo, invoice, dsb.\n3. Berikan jawaban dalam Bahasa Indonesia yang sopan, rapi (gunakan format Rupiah seperti Rp 150.000, poin-poin, dan emotikon yang sesuai).\n4. Jika ditanya tentang total, hitung akumulasi nominal dengan tepat berdasarkan data riil dari Google Sheets."
        }
      },
